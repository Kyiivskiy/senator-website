# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real tokens.

TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-or-group-id
ALLOWED_ORIGIN=https://kyiivskiy.github.io

# A long random string only you (and the site's frontend) know.
# Stops random people from POSTing fake "orders" straight to this
# endpoint and spamming your Telegram. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORDER_API_KEY=generate-a-long-random-string-here
